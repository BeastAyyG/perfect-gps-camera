<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PerfectGpsCamera" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/camera_navy_deep</item>
        <item name="android:windowBackground">@color/camera_navy_deep</item>
        <item name="android:colorAccent">@color/camera_gold</item>
    </style>

    <style name="Theme.PerfectGpsCamera.Splash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/camera_navy_deep</item>
        <item name="android:navigationBarColor">@color/camera_navy_deep</item>
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:colorAccent">@color/camera_gold</item>
    </style>

    <style name="Theme.PerfectGpsCamera.Onboarding" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/camera_navy_deep</item>
        <item name="android:navigationBarColor">@color/camera_navy_deep</item>
        <item name="android:windowBackground">@color/camera_navy_deep</item>
        <item name="android:colorAccent">@color/camera_gold</item>
    </style>
</resources>
